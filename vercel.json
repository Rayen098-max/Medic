{
  "rewrites": [
    { "source": "/r/(.*)", "destination": "/api/portal?id=$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/og.jsx": {
      "runtime": "edge"
    },
    "api/portal.js": {
      "runtime": "nodejs20.x",
      "includeFiles": "dist/index.html"
    }
  }
}
